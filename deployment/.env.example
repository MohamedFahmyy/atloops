# ==============================================================================
# AT LOOPS ENTERPRISE — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to backend/.env and replace placeholders with secure enterprise secrets
# ==============================================================================

APP_NAME="AT LOOPS Enterprise"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://atloops.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,slack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (MySQL 8.4+)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=atloops_enterprise_prod
DB_USERNAME=atloops_app_user
DB_PASSWORD="REPLACE_WITH_STRONG_GENERATED_PASSWORD"

# ------------------------------------------------------------------------------
# SESSION & CACHE CONFIGURATION
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=atloops.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# ------------------------------------------------------------------------------
# REDIS (Optional for High-Traffic Enterprise Deployments)
# ------------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# SMTP / MAIL NOTIFICATIONS (Official Corporate Gateway)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=contact@atloops.com
MAIL_PASSWORD="REPLACE_WITH_MICROSOFT_APP_PASSWORD"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="contact@atloops.com"
MAIL_FROM_NAME="AT LOOPS Enterprise"

# ------------------------------------------------------------------------------
# CORS & FRONTEND CLIENT ORIGIN
# ------------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=atloops.com
CORS_ALLOWED_ORIGINS=https://atloops.com
